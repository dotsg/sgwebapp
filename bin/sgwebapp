#!/bin/bash

# sgwebapp - Fast, native Web App manager for macOS
# Brings Omarchy's seamless web app experience to macOS users.
# Reuses Chrome's native session, cookies, and profile.

set -euo pipefail

VERSION="1.0.0"
# Both roots are overridable so the test suite never touches the real ones.
CONFIG_DIR="${SGWEBAPP_CONFIG_DIR:-$HOME/.config/sgwebapp}"
CONFIG_FILE="$CONFIG_DIR/config.json"
APPS_DIR="${SGWEBAPP_APPS_DIR:-$HOME/Applications}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BORDER_BIN="$SCRIPT_DIR/sgwebapp-border"
RUNTIME_BIN="$SCRIPT_DIR/sgwebapp-runtime"
PID_FILE="$CONFIG_DIR/border.pid"
COOKIE_JAR="$CONFIG_DIR/cookiejar.json"
PENDING_DIR="$CONFIG_DIR/pending"

# Helper scripts and Swift sources live next to the repo when running from a
# checkout, and under $PREFIX/share/sgwebapp once `make install` has run.
TOOLS_DIR=""
SRC_DIR=""
for _cand in "$SCRIPT_DIR/../src" "$SCRIPT_DIR/../share/sgwebapp"; do
  if [[ -d "$_cand/tools" && -z "$TOOLS_DIR" ]]; then TOOLS_DIR="$_cand/tools"; fi
  if [[ -d "$_cand/runtime" && -z "$SRC_DIR" ]]; then SRC_DIR="$_cand"; fi
done
unset _cand
CLEANUP_DIRS=()

cleanup() {
  local dir
  for dir in "${CLEANUP_DIRS[@]:-}"; do
    if [[ -n "$dir" && -d "$dir" ]]; then
      rm -rf "$dir"
    fi
  done
}
trap cleanup EXIT

# Colors for terminal output
# ANSI-C quoting so the escapes are real characters: print_help pipes these
# through `cat`, which does not interpret backslash escapes the way echo -e does.
BOLD=$'\033[1m'
GREEN=$'\033[0;32m'
BLUE=$'\033[0;34m'
YELLOW=$'\033[0;33m'
RED=$'\033[0;31m'
RESET=$'\033[0m'

log_info() { echo -e "${BLUE}==>${RESET} ${BOLD}$1${RESET}"; }
log_success() { echo -e "${GREEN}==>${RESET} ${BOLD}$1${RESET}"; }
log_warn() { echo -e "${YELLOW}Warning:${RESET} $1"; }
log_error() { echo -e "${RED}Error:${RESET} $1" >&2; }

print_help() {
  cat <<EOF
${BOLD}sgwebapp${RESET} - Native Web App manager for macOS (v${VERSION})
Brings Omarchy's seamless web app experience to macOS.

${BOLD}USAGE:${RESET}
  sgwebapp <command> [arguments]

${BOLD}COMMANDS:${RESET}
  install <name> <url> [icon]   Install a web app to ~/Applications
  list                          List all installed web apps
  launch <name|url>             Launch an installed web app or arbitrary URL
  remove <name>                 Remove an installed web app
  config [get|set|reset]        View or update default border & engine configuration
  border <start|stop|status|run> Manage the native floating window border daemon
  import-cookies <name>         Seed a web app's login from your Chrome profile
                                (add --dry-run to preview without a keychain prompt)
  cookies <status|clear>        Inspect or wipe the shared login cookie jar
  version                       Show version information
  help                          Show this help message

${BOLD}OPTIONS (install):${RESET}
  --engine <native|chrome>      Renderer engine (native: 0-bar + border; chrome: uses Chrome session)
  --border-color <color>        Border color: tahoe (default), auto, or hex (e.g. 89b4fa)
  --border-width <width>        Border stroke width in pt (default: 0.5)
  --border-radius <radius>      Corner radius in pt (default: 26.0)
  --padding <pt>                Content padding inside the border in pt (default: 8.0)
  --icon <path|url>             Custom application icon
  --no-share-login              Do not sync SSO cookies with other sgwebapp apps
  --force                       Overwrite an existing app bundle of the same name

${BOLD}EXAMPLES:${RESET}
  sgwebapp install "Solaree" "https://solaree.ai/index_cn.html"
  sgwebapp install "Solaree" "https://solaree.ai/index_cn.html" --padding 10
  sgwebapp install "Google Maps" "https://www.google.com/maps"
  sgwebapp config set padding 10.0
  sgwebapp config set border_color 89b4fa
  sgwebapp config set border_radius 18.0
  sgwebapp config reset
  sgwebapp list
  sgwebapp launch "Solaree"
  sgwebapp border start
  sgwebapp import-cookies "Solaree"
  sgwebapp cookies status
  sgwebapp remove "Solaree"

EOF
}

# Find Chromium browser
find_chromium_browser() {
  if [[ -n "${SGWEBAPP_BROWSER:-}" && -x "$SGWEBAPP_BROWSER" ]]; then
    printf '%s' "$SGWEBAPP_BROWSER"
    return 0
  fi

  local candidates=(
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
    "$HOME/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
    "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"
    "$HOME/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"
    "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"
    "$HOME/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"
    "/Applications/Arc.app/Contents/MacOS/Arc"
    "/Applications/Chromium.app/Contents/MacOS/Chromium"
  )

  for bin in "${candidates[@]}"; do
    if [[ -x "$bin" ]]; then
      printf '%s' "$bin"
      return 0
    fi
  done

  log_error "No Chromium-based browser found. Please install Google Chrome, Brave, or Edge."
  exit 1
}

# Normalize and validate URL
normalize_url() {
  local url="$1"
  if [[ ! "$url" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*:// ]]; then
    url="https://$url"
  fi

  if [[ ! "$url" =~ ^https?:// ]]; then
    log_error "Web app URL must start with http:// or https://"
    exit 1
  fi

  if [[ "$url" =~ [[:space:]] ]]; then
    log_error "Web app URL cannot contain spaces"
    exit 1
  fi

  printf '%s' "$url"
}

# Sanitize app name for filenames and bundle identifier.
# Names with no ASCII alphanumerics at all (e.g. pure CJK) would otherwise all
# collapse to the same identifier, so fall back to a hash of the original name.
safe_app_name() {
  local cleaned
  cleaned=$(printf '%s' "$1" | sed 's/[^a-zA-Z0-9_-]//g' | tr '[:upper:]' '[:lower:]')
  if [[ -z "$cleaned" ]]; then
    cleaned="app-$(printf '%s' "$1" | shasum -a 256 | cut -c1-10)"
  fi
  printf '%s' "$cleaned"
}

# Escape a value for embedding in XML character data (Info.plist).
xml_escape() {
  printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' \
                         -e 's/"/\&quot;/g' -e "s/'/\&apos;/g"
}

# Emit a JSON string literal (including the surrounding quotes) for a value.
json_string() {
  python3 -c 'import json,sys; sys.stdout.write(json.dumps(sys.argv[1]))' "$1"
}

# Extract the host from a normalized http(s) URL.
url_host() {
  printf '%s' "$1" | sed -E 's|^https?://([^/:]+).*|\1|'
}

# Reduce a host to its registrable domain (best effort, good enough for cookies).
# Not a Public Suffix List: it handles IP literals and the common two-label
# suffixes, which is where naive "last two labels" goes visibly wrong.
registrable_domain() {
  local host="$1"

  # An IPv4 literal has no registrable domain; "127.0.0.1" must not become "0.1".
  if [[ "$host" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    printf '%s' "$host"
    return 0
  fi
  # Bracketed IPv6, or any host with no dot at all (localhost, an intranet name).
  if [[ "$host" == \[*\] || "$host" != *.* ]]; then
    printf '%s' "$host"
    return 0
  fi

  local parts
  parts=$(awk -F. '{print NF}' <<<"$host")
  if (( parts <= 2 )); then
    printf '%s' "$host"
    return 0
  fi

  # co.uk, com.cn, com.au ... need three labels, not two.
  local last_two
  last_two=$(awk -F. '{print $(NF-1)"."$NF}' <<<"$host")
  case "$last_two" in
    co.uk|org.uk|ac.uk|gov.uk|me.uk|net.uk|sch.uk \
    |com.cn|net.cn|org.cn|gov.cn|edu.cn|ac.cn \
    |com.au|net.au|org.au|edu.au|gov.au \
    |co.jp|or.jp|ne.jp|ac.jp|go.jp \
    |com.br|com.mx|com.tw|com.hk|com.sg|com.tr|com.ar|co.kr|co.in|co.nz|co.za)
      if (( parts >= 3 )); then
        awk -F. '{print $(NF-2)"."$(NF-1)"."$NF}' <<<"$host"
      else
        printf '%s' "$host"
      fi
      ;;
    *)
      printf '%s' "$last_two"
      ;;
  esac
}

# Validate app name
validate_name() {
  local name="$1"
  if [[ -z "$name" ]]; then
    log_error "App name cannot be empty."
    exit 1
  fi
  if [[ "$name" == *"/"* ]]; then
    log_error "App name cannot contain '/': $name"
    exit 1
  fi
  if [[ "$name" == "."* ]]; then
    log_error "App name cannot start with a dot: $name"
    exit 1
  fi
}

# Fetch site icon or convert custom icon
prepare_icon() {
  local site_url="$1"
  local icon_arg="${2:-}"
  local iconset_dir="$3"
  local temp_dir="$4"
  local app_name_for_icon="${5:-app}"
  local raw_icon="$temp_dir/raw_icon.png"

  mkdir -p "$iconset_dir"

  local downloaded_raw="$temp_dir/raw_downloaded"

  # Case 1: Custom local image file
  if [[ -n "$icon_arg" && -f "$icon_arg" ]]; then
    log_info "Using provided local icon: $icon_arg"
    cp "$icon_arg" "$downloaded_raw"
  # Case 2: Custom image URL
  elif [[ -n "$icon_arg" && "$icon_arg" =~ ^https?:// ]]; then
    log_info "Downloading icon from: $icon_arg"
    curl -fsSL -L --max-time 10 "$icon_arg" -o "$downloaded_raw" 2>/dev/null || true
  fi

  # Case 3: Auto-detect from website HTML
  if [[ ! -s "$downloaded_raw" ]]; then
    log_info "Fetching high-resolution icon from $site_url..."
    local origin
    origin=$(sed -E 's|^(https?://[^/]+).*|\1|' <<<"$site_url")
    local domain
    domain=$(sed -E 's|^https?://([^/:]+).*|\1|' <<<"$site_url")

    local html_file="$temp_dir/site.html"
    curl -fsSL -L --max-time 8 "$site_url" -o "$html_file" 2>/dev/null || true

    local icon_url=""
    if [[ -s "$html_file" ]]; then
      # Extract all <link> tags
      local link_tags
      link_tags=$(grep -oiE '<link[^>]+>' "$html_file" || true)

      # 1. Try apple-touch-icon
      local apple_tag
      apple_tag=$(grep -i 'apple-touch-icon' <<<"$link_tags" | head -1 || true)
      if [[ -n "$apple_tag" ]]; then
        icon_url=$(grep -oiE 'href=["'\''][^"'\'']+' <<<"$apple_tag" | head -1 | sed -E 's/^href=["'\'']//' || true)
      fi

      # 2. Try generic rel="icon"
      if [[ -z "$icon_url" ]]; then
        local icon_tag
        icon_tag=$(grep -iE 'rel=["'\''][^"'\'']*icon' <<<"$link_tags" | head -1 || true)
        if [[ -n "$icon_tag" ]]; then
          icon_url=$(grep -oiE 'href=["'\''][^"'\'']+' <<<"$icon_tag" | head -1 | sed -E 's/^href=["'\'']//' || true)
        fi
      fi
    fi

    if [[ -n "$icon_url" ]]; then
      case "$icon_url" in
        http://* | https://*) ;;
        //*) icon_url="https:$icon_url" ;;
        /*) icon_url="$origin$icon_url" ;;
        *) icon_url="$origin/$icon_url" ;;
      esac
      curl -fsSL -L --max-time 8 "$icon_url" -o "$downloaded_raw" 2>/dev/null || true
    fi

    # Fallback 1: origin/apple-touch-icon.png
    if [[ ! -s "$downloaded_raw" ]]; then
      curl -fsSL -L --max-time 5 "$origin/apple-touch-icon.png" -o "$downloaded_raw" 2>/dev/null || true
    fi

    # Fallback 2: Google 256px Favicon API
    if [[ ! -s "$downloaded_raw" ]]; then
      curl -fsSL -L --max-time 6 "https://www.google.com/s2/favicons?domain=${domain}&sz=256" -o "$downloaded_raw" 2>/dev/null || true
    fi
  fi

  # Convert downloaded raw image to standardized PNG
  if [[ -s "$downloaded_raw" ]]; then
    sips -s format png "$downloaded_raw" --out "$raw_icon" >/dev/null 2>&1 || cp "$downloaded_raw" "$raw_icon"
  fi

  # Fallback 3: Generate a visible placeholder if every fetch failed. The old
  # fallback was a 1x1 transparent pixel, which upscaled to a blank Dock icon.
  if [[ ! -s "$raw_icon" ]]; then
    log_warn "Could not fetch a site icon. Generating a placeholder icon instead."
    python3 "$TOOLS_DIR/fallback_icon.py" "$app_name_for_icon" "$raw_icon" || true
  fi

  # Build complete macOS .iconset using sips
  local sizes=(
    "icon_16x16.png:16"
    "icon_16x16@2x.png:32"
    "icon_32x32.png:32"
    "icon_32x32@2x.png:64"
    "icon_128x128.png:128"
    "icon_128x128@2x.png:256"
    "icon_256x256.png:256"
    "icon_256x256@2x.png:512"
    "icon_512x512.png:512"
    "icon_512x512@2x.png:1024"
  )

  for entry in "${sizes[@]}"; do
    local filename="${entry%%:*}"
    local s="${entry##*:}"
    sips -z "$s" "$s" "$raw_icon" --out "$iconset_dir/$filename" >/dev/null 2>&1 || true
  done
}

# Read a key from the JSON config. Values are passed as argv, never spliced
# into the Python source, so a crafted key or path cannot execute code.
get_config_val() {
  local key="$1"
  local default_val="$2"
  if [[ ! -f "$CONFIG_FILE" ]]; then
    printf '%s\n' "$default_val"
    return 0
  fi
  python3 - "$CONFIG_FILE" "$key" "$default_val" <<'PY' 2>/dev/null || printf '%s\n' "$default_val"
import json, sys
path, key, default = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    with open(path) as fh:
        data = json.load(fh)
except Exception:
    print(default)
    sys.exit(0)
value = data.get(key, default)
if isinstance(value, bool):
    value = "true" if value else "false"
elif isinstance(value, list):
    value = ",".join(str(v) for v in value)
print(value)
PY
}

set_config_val() {
  local key="$1"
  local val="$2"
  mkdir -p "$CONFIG_DIR"
  python3 - "$CONFIG_FILE" "$key" "$val" <<'PY'
import json, os, sys
path, key, raw = sys.argv[1], sys.argv[2], sys.argv[3]
data = {}
if os.path.exists(path):
    try:
        with open(path) as fh:
            data = json.load(fh)
    except Exception:
        data = {}
if key == "shared_cookie_domains":
    value = [d.strip() for d in raw.split(",") if d.strip()]
elif raw.lower() in ("true", "false"):
    value = raw.lower() == "true"
else:
    try:
        value = float(raw) if "." in raw else int(raw)
    except ValueError:
        value = raw
data[key] = value
with open(path, "w") as fh:
    json.dump(data, fh, indent=2)
PY
}

# Read a key out of an app bundle's sgwebapp.json metadata.
read_meta() {
  local meta="$1" key="$2" default_val="${3:-}"
  python3 - "$meta" "$key" "$default_val" <<'PY' 2>/dev/null || printf '%s\n' "$default_val"
import json, sys
try:
    with open(sys.argv[1]) as fh:
        print(json.load(fh).get(sys.argv[2], sys.argv[3]))
except Exception:
    print(sys.argv[3])
PY
}

# Install subcommand
cmd_install() {
  local def_color def_width def_radius def_padding def_engine
  def_color=$(get_config_val "border_color" "tahoe")
  def_width=$(get_config_val "border_width" "0.5")
  def_radius=$(get_config_val "border_radius" "26.0")
  def_padding=$(get_config_val "padding" "8.0")
  def_engine=$(get_config_val "engine" "native")

  local def_share
  def_share=$(get_config_val "share_login" "true")

  local app_name=""
  local app_url=""
  local custom_icon=""
  local engine="$def_engine"
  local border_color="$def_color"
  local border_width="$def_width"
  local border_radius="$def_radius"
  local content_padding="$def_padding"
  local share_login="$def_share"
  local force=0

  # Options that take a value must not read past the end of the argument list;
  # with `set -u` a bare `$2` would abort with an unbound-variable message.
  need_value() {
    if (( $# < 2 )); then
      log_error "Option $1 requires a value."
      exit 1
    fi
  }

  local pos_args=()
  while (( $# > 0 )); do
    case "$1" in
      --engine) need_value "$@"; engine="$2"; shift 2 ;;
      --border-color|--color) need_value "$@"; border_color="$2"; shift 2 ;;
      --border-width|--width) need_value "$@"; border_width="$2"; shift 2 ;;
      --border-radius|--radius) need_value "$@"; border_radius="$2"; shift 2 ;;
      --padding) need_value "$@"; content_padding="$2"; shift 2 ;;
      --icon) need_value "$@"; custom_icon="$2"; shift 2 ;;
      --no-share-login) share_login="false"; shift ;;
      --share-login) share_login="true"; shift ;;
      --force) force=1; shift ;;
      --*) log_error "Unknown option: $1"; exit 1 ;;
      *) pos_args+=("$1"); shift ;;
    esac
  done

  case "$engine" in
    native|chrome) ;;
    *) log_error "Unknown engine '$engine'. Use 'native' or 'chrome'."; exit 1 ;;
  esac

  if (( ${#pos_args[@]} < 2 )); then
    if (( ${#pos_args[@]} == 1 )); then
      app_name="${pos_args[0]}"
    else
      echo -e "${BOLD}Create a new macOS Web App${RESET}"
      read -rp "App Name (e.g. Solaree): " app_name
    fi
    read -rp "App URL (e.g. https://solaree.ai/index_cn.html): " app_url
    if [[ -z "$custom_icon" ]]; then
      read -rp "Custom Icon URL/path (optional, press Enter to auto-detect): " custom_icon
    fi
  else
    app_name="${pos_args[0]}"
    app_url="${pos_args[1]}"
    if [[ -z "$custom_icon" && ${#pos_args[@]} -ge 3 ]]; then
      custom_icon="${pos_args[2]}"
    fi
  fi

  validate_name "$app_name"
  local url
  url=$(normalize_url "$app_url")

  # Only the Chrome engine needs a browser on disk. The native engine renders
  # with WebKit and used to fail installation here for no reason.
  local browser_exec=""
  if [[ "$engine" == "chrome" ]]; then
    browser_exec=$(find_chromium_browser)
  fi

  local safe_id
  safe_id=$(safe_app_name "$app_name")

  local app_bundle="$APPS_DIR/$app_name.app"
  local macos_dir="$app_bundle/Contents/MacOS"
  local resources_dir="$app_bundle/Contents/Resources"

  # Never silently overwrite an application we did not create.
  if [[ -d "$app_bundle" ]]; then
    if [[ ! -f "$app_bundle/Contents/Resources/sgwebapp.json" ]]; then
      log_error "$app_bundle already exists and was not created by sgwebapp."
      log_error "Refusing to overwrite it. Choose a different name."
      exit 1
    fi
    if (( force == 0 )); then
      log_warn "Web app '$app_name' already exists; reinstalling it."
      log_warn "Its saved logins are kept. Pass --force to skip this notice."
    fi
  fi

  log_info "Installing Web App: ${BOLD}$app_name${RESET} -> $url [engine: $engine]"
  mkdir -p "$APPS_DIR" "$macos_dir" "$resources_dir"

  # Icon generation
  local temp_dir
  temp_dir=$(mktemp -d)
  CLEANUP_DIRS+=("$temp_dir")
  local iconset_dir="$temp_dir/AppIcon.iconset"

  prepare_icon "$url" "$custom_icon" "$iconset_dir" "$temp_dir" "$app_name"

  local icns_dest="$resources_dir/AppIcon.icns"
  iconutil -c icns "$iconset_dir" -o "$icns_dest" 2>/dev/null || true

  local exec_name="$app_name"

  if [[ "$engine" == "native" ]]; then
    # Ensure native runtime is compiled
    if [[ ! -x "$RUNTIME_BIN" ]]; then
      if [[ -z "$SRC_DIR" ]]; then
        log_error "sgwebapp-runtime is missing and its source could not be found."
        log_error "Run 'make build' in the sgwebapp checkout, or reinstall."
        exit 1
      fi
      log_info "Compiling native borderless runtime..."
      swiftc -O "$SRC_DIR/runtime/main.swift" -o "$RUNTIME_BIN"
    fi
    cp "$RUNTIME_BIN" "$macos_dir/$app_name"
    chmod +x "$macos_dir/$app_name"
  else
    # Chrome engine launcher
    exec_name="launcher"
    local launcher_file="$macos_dir/launcher"
    cat > "$launcher_file" <<EOF
#!/bin/bash
# Generated by sgwebapp (Chrome engine)
exec "$browser_exec" --app="$url" "\$@"
EOF
    chmod +x "$launcher_file"
  fi

  # Values below land inside XML, so they must be escaped: an app name or URL
  # containing & or < would otherwise produce an Info.plist macOS cannot parse.
  local esc_name esc_url esc_exec esc_color
  esc_name=$(xml_escape "$app_name")
  esc_url=$(xml_escape "$url")
  esc_exec=$(xml_escape "$exec_name")
  esc_color=$(xml_escape "$border_color")

  local share_login_xml="<false/>"
  [[ "$share_login" == "true" ]] && share_login_xml="<true/>"

  # Create Info.plist
  cat > "$app_bundle/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>${esc_exec}</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>CFBundleIdentifier</key>
  <string>com.sgwebapp.app.${safe_id}</string>
  <key>CFBundleName</key>
  <string>${esc_name}</string>
  <key>CFBundleDisplayName</key>
  <string>${esc_name}</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>${VERSION}</string>
  <key>CFBundleVersion</key>
  <string>${VERSION}</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>SGWebAppURL</key>
  <string>${esc_url}</string>
  <key>SGWebAppShareLogin</key>
  ${share_login_xml}
  <key>SGWebAppBorderColor</key>
  <string>${esc_color}</string>
  <key>SGWebAppBorderWidth</key>
  <real>${border_width}</real>
  <key>SGWebAppCornerRadius</key>
  <real>${border_radius}</real>
  <key>SGWebAppPadding</key>
  <real>${content_padding}</real>
</dict>
</plist>
EOF

  # Save sgwebapp metadata
  local created_date
  created_date=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  # Written through json_string so names, URLs and paths containing quotes or
  # backslashes cannot produce a malformed metadata file.
  local browser_json="null"
  [[ -n "$browser_exec" ]] && browser_json=$(json_string "$browser_exec")
  cat > "$resources_dir/sgwebapp.json" <<EOF
{
  "name": $(json_string "$app_name"),
  "url": $(json_string "$url"),
  "engine": $(json_string "$engine"),
  "browser": $browser_json,
  "border_color": $(json_string "$border_color"),
  "border_width": $border_width,
  "border_radius": $border_radius,
  "padding": $content_padding,
  "share_login": $share_login,
  "bundle_id": "com.sgwebapp.app.${safe_id}",
  "created_at": "$created_date"
}
EOF

  # Register with macOS LaunchServices
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app_bundle" 2>/dev/null || touch "$app_bundle"

  log_success "Web App successfully installed to:"
  echo "    $app_bundle"
  echo ""
  echo -e "  • ${BOLD}Launch with Spotlight:${RESET} Press ${GREEN}Cmd + Space${RESET}, type '${app_name}' and Enter"
  echo -e "  • ${BOLD}Launch with CLI:${RESET}       sgwebapp launch \"$app_name\""
  if [[ "$engine" == "chrome" ]]; then
    echo -e "  • ${BOLD}Add Window Border:${RESET}     sgwebapp border start"
  else
    echo -e "  • ${BOLD}Reuse Chrome login:${RESET}    sgwebapp import-cookies \"$app_name\""
  fi
  echo ""
}

# List subcommand
cmd_list() {

  if [[ ! -d "$APPS_DIR" ]]; then
    echo "No Web Apps installed in $APPS_DIR"
    return 0
  fi

  local apps=()
  while IFS= read -r -d '' app_path; do
    if [[ -f "$app_path/Contents/Resources/sgwebapp.json" ]]; then
      apps+=("$app_path")
    fi
  done < <(find "$APPS_DIR" -maxdepth 1 -name "*.app" -print0 2>/dev/null)

  if (( ${#apps[@]} == 0 )); then
    echo "No sgwebapp Web Apps found in $APPS_DIR"
    return 0
  fi

  printf "%-22s %-10s %-42s %s\n" "APP NAME" "ENGINE" "URL" "PATH"
  printf "%-22s %-10s %-42s %s\n" "--------" "------" "---" "----"

  for app_path in "${apps[@]}"; do
    local meta="$app_path/Contents/Resources/sgwebapp.json"
    local name url engine
    name=$(read_meta "$meta" name "$(basename "$app_path" .app)")
    url=$(read_meta "$meta" url "unknown")
    engine=$(read_meta "$meta" engine "chrome")
    printf "%-22s %-10s %-42s %s\n" "$name" "$engine" "$url" "$app_path"
  done
}

# Launch subcommand
cmd_launch() {
  if (( $# == 0 )); then
    log_error "Usage: sgwebapp launch <name|url>"
    exit 1
  fi

  local target="$1"
  shift

  # If it's an installed app name
  local app_path="$APPS_DIR/$target.app"
  if [[ -d "$app_path" ]]; then
    log_info "Launching $target..."
    open "$app_path" --args "$@"
    return 0
  fi

  # If it's a URL
  if [[ "$target" =~ ^https?:// ]]; then
    local browser_exec
    browser_exec=$(find_chromium_browser)
    log_info "Opening $target as web app..."
    exec "$browser_exec" --app="$target" "$@"
  fi

  log_error "Could not find installed web app named '$target'. Run 'sgwebapp list' to see installed apps."
  exit 1
}

# Remove subcommand
cmd_remove() {
  if (( $# == 0 )); then
    log_info "Select a web app to remove:"
    local apps=()
    while IFS= read -r -d '' app_path; do
      if [[ -f "$app_path/Contents/Resources/sgwebapp.json" ]]; then
        apps+=("$(basename "$app_path" .app)")
      fi
    done < <(find "$APPS_DIR" -maxdepth 1 -name "*.app" -print0 2>/dev/null)

    if (( ${#apps[@]} == 0 )); then
      echo "No web apps to remove."
      return 0
    fi

    select chosen in "${apps[@]}" "Cancel"; do
      if [[ "$chosen" == "Cancel" || -z "$chosen" ]]; then
        echo "Cancelled."
        return 0
      fi
      local app_name="$chosen"
      break
    done
  else
    local app_name="$1"
  fi

  # This path feeds `rm -rf`, so the name must be validated exactly like it is
  # on install: "../../foo" would otherwise escape ~/Applications entirely.
  validate_name "$app_name"

  local app_path="$APPS_DIR/$app_name.app"
  if [[ ! -d "$app_path" ]]; then
    log_error "Web App '$app_name' not found at $app_path"
    exit 1
  fi
  if [[ ! -f "$app_path/Contents/Resources/sgwebapp.json" ]]; then
    log_error "$app_path was not created by sgwebapp; refusing to delete it."
    exit 1
  fi

  # Deregister from LaunchServices
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -u "$app_path" 2>/dev/null || true

  rm -rf "$app_path"
  log_success "Removed Web App: $app_name"
}

# Border daemon management
cmd_border() {
  local action="${1:-status}"
  shift || true

  mkdir -p "$CONFIG_DIR"

  # Ensure border daemon binary is compiled
  if [[ ! -x "$BORDER_BIN" ]]; then
    if [[ -z "$SRC_DIR" ]]; then
      log_error "sgwebapp-border is missing and its source could not be found."
      log_error "Run 'make build' in the sgwebapp checkout, or reinstall."
      exit 1
    fi
    log_info "Compiling native Swift border daemon..."
    swiftc -O "$SRC_DIR/border/main.swift" -o "$BORDER_BIN"
  fi

  case "$action" in
    start)
      if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
          log_warn "Border daemon is already running (PID: $pid)."
          return 0
        fi
      fi
      log_info "Starting border daemon..."
      nohup "$BORDER_BIN" "$@" > "$CONFIG_DIR/border.log" 2>&1 &
      local new_pid=$!
      echo "$new_pid" > "$PID_FILE"
      sleep 0.2
      if kill -0 "$new_pid" 2>/dev/null; then
        log_success "Border daemon started (PID: $new_pid). Logs: $CONFIG_DIR/border.log"
      else
        log_error "Border daemon failed to start. Check $CONFIG_DIR/border.log"
        exit 1
      fi
      ;;
    stop)
      if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
          kill "$pid" 2>/dev/null || true
          log_success "Stopped border daemon (PID: $pid)."
        else
          log_warn "Border daemon process ($pid) not found."
        fi
        rm -f "$PID_FILE"
      else
        # Fallback killall
        pkill -f "sgwebapp-border" 2>/dev/null || true
        log_info "No border PID file found; killed any running instances."
      fi
      ;;
    status)
      if [[ -f "$PID_FILE" ]]; then
        local pid
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
          echo -e "Border daemon is ${GREEN}running${RESET} (PID: $pid)"
          return 0
        fi
      fi
      echo -e "Border daemon is ${YELLOW}stopped${RESET}"
      ;;
    run)
      log_info "Running border daemon in foreground (Ctrl+C to stop)..."
      exec "$BORDER_BIN" "$@"
      ;;
    *)
      log_error "Unknown border action: $action. Use start, stop, status, or run."
      exit 1
      ;;
  esac
}

# Resolve an installed app bundle by name, or exit with a helpful message.
resolve_app() {
  local name="$1"
  validate_name "$name"
  local path="$APPS_DIR/$name.app"
  if [[ ! -f "$path/Contents/Resources/sgwebapp.json" ]]; then
    log_error "No sgwebapp web app named '$name'. Run 'sgwebapp list'."
    exit 1
  fi
  printf '%s' "$path"
}

# Seed one web app's login from a Chromium profile.
cmd_import_cookies() {
  if (( $# == 0 )); then
    log_error "Usage: sgwebapp import-cookies <name> [--browser chrome|brave|edge|chromium] [--profile Default] [--domain example.com]"
    exit 1
  fi

  local app_name="$1"; shift
  local browser="chrome"
  local profile="Default"
  local domains=()
  local dry_run=0

  while (( $# > 0 )); do
    case "$1" in
      --browser) [[ $# -ge 2 ]] || { log_error "--browser requires a value"; exit 1; }; browser="$2"; shift 2 ;;
      --profile) [[ $# -ge 2 ]] || { log_error "--profile requires a value"; exit 1; }; profile="$2"; shift 2 ;;
      --domain)  [[ $# -ge 2 ]] || { log_error "--domain requires a value"; exit 1; }; domains+=("$2"); shift 2 ;;
      --dry-run) dry_run=1; shift ;;
      *) log_error "Unknown option: $1"; exit 1 ;;
    esac
  done

  local app_path meta url engine bundle_id
  app_path=$(resolve_app "$app_name")
  meta="$app_path/Contents/Resources/sgwebapp.json"
  url=$(read_meta "$meta" url "")
  engine=$(read_meta "$meta" engine "native")
  bundle_id=$(read_meta "$meta" bundle_id "")
  # Metadata is the source of truth, but fall back to the bundle itself if that
  # file was hand-edited or truncated.
  if [[ -z "$bundle_id" && -f "$app_path/Contents/Info.plist" ]]; then
    bundle_id=$(plutil -extract CFBundleIdentifier raw -o - "$app_path/Contents/Info.plist" 2>/dev/null || true)
  fi

  if [[ "$engine" == "chrome" ]]; then
    log_warn "'$app_name' uses the Chrome engine and already shares Chrome's live session."
    log_warn "Importing cookies is only useful for native-engine apps."
    return 0
  fi
  if [[ -z "$bundle_id" ]]; then
    log_error "Could not determine the bundle identifier for '$app_name'; reinstall the app."
    exit 1
  fi

  # Default to the app's own registrable domain, so an import never hoovers up
  # credentials for unrelated sites.
  if (( ${#domains[@]} == 0 )); then
    local host
    host=$(url_host "$url")
    domains+=("$(registrable_domain "$host")")
  fi

  local domain_args=()
  local d
  for d in "${domains[@]}"; do
    domain_args+=(--domain "$d")
  done

  if [[ -z "$TOOLS_DIR" || ! -f "$TOOLS_DIR/chrome_cookies.py" ]]; then
    log_error "chrome_cookies.py could not be found."
    log_error "Run this from an sgwebapp checkout, or reinstall with 'make install'."
    exit 1
  fi

  # Lets you confirm which domains would be read before triggering a keychain
  # prompt, and gives the test suite a way to exercise domain resolution.
  if (( dry_run == 1 )); then
    log_info "Would read $browser cookies for: ${domains[*]}"
    echo "    target app:  $app_name ($bundle_id)"
    echo "    staging file: $PENDING_DIR/$bundle_id.json"
    return 0
  fi

  log_info "Reading $browser cookies for: ${domains[*]}"
  log_warn "macOS will ask for keychain access to '$browser Safe Storage'. Choose Allow."

  mkdir -p "$PENDING_DIR"
  chmod 700 "$PENDING_DIR"
  local out="$PENDING_DIR/$bundle_id.json"

  if python3 "$TOOLS_DIR/chrome_cookies.py" \
       --browser "$browser" --profile "$profile" "${domain_args[@]}" --out "$out"; then
    log_success "Cookies staged for '$app_name'."
    echo "    They are injected the next time the app starts, then the staging file is deleted."
    echo "    Staged at: $out"
  else
    log_error "Cookie import failed. '$app_name' will keep using its own login."
    exit 1
  fi
}

# Inspect or wipe the shared login jar.
cmd_cookies() {
  local action="${1:-status}"

  case "$action" in
    status)
      echo -e "${BOLD}sgwebapp login cookie jar${RESET}"
      if [[ -f "$COOKIE_JAR" ]]; then
        local count perms
        count=$(python3 - "$COOKIE_JAR" <<'PY' 2>/dev/null || echo "?"
import json, sys
try:
    with open(sys.argv[1]) as fh:
        print(len(json.load(fh).get("cookies", [])))
except Exception:
    print("?")
PY
)
        perms=$(stat -f "%Sp" "$COOKIE_JAR")
        echo "  • file:    $COOKIE_JAR"
        echo "  • cookies: $count"
        echo "  • mode:    $perms (must be -rw-------)"
      else
        echo "  • file:    $COOKIE_JAR (does not exist yet)"
      fi
      local pending_count=0
      if [[ -d "$PENDING_DIR" ]]; then
        pending_count=$(find "$PENDING_DIR" -maxdepth 1 -name "*.json" | wc -l | tr -d ' ')
      fi
      echo "  • staged imports awaiting first launch: $pending_count"
      echo ""
      local shared
      shared=$(get_config_val shared_cookie_domains "")
      if [[ -z "$shared" ]]; then
        shared="built-in default (Google, GitHub, Microsoft, Apple, Okta, Auth0, Slack, Atlassian)"
      fi
      echo "  Shared domains: $shared"
      echo "  Change them with: sgwebapp config set shared_cookie_domains \"google.com,github.com\""
      echo "  Disable syncing entirely with: sgwebapp config set share_login false"
      ;;
    clear)
      rm -f "$COOKIE_JAR"
      rm -rf "$PENDING_DIR"
      log_success "Cleared the shared cookie jar and any staged imports."
      echo "  Logins already stored inside each app are untouched."
      ;;
    *)
      log_error "Unknown cookies action: $action. Use 'status' or 'clear'."
      exit 1
      ;;
  esac
}

# Config subcommand
cmd_config() {
  local action="${1:-get}"
  shift || true

  mkdir -p "$CONFIG_DIR"

  case "$action" in
    get|list|"")
      echo -e "${BOLD}Current sgwebapp Configuration (Defaults to macOS Tahoe style):${RESET}"
      local cur_color cur_width cur_radius cur_padding cur_engine cur_share
      cur_color=$(get_config_val "border_color" "tahoe")
      cur_width=$(get_config_val "border_width" "0.5")
      cur_radius=$(get_config_val "border_radius" "26.0")
      cur_padding=$(get_config_val "padding" "8.0")
      cur_engine=$(get_config_val "engine" "native")
      cur_share=$(get_config_val "share_login" "true")
      echo "  • border_color:  $cur_color (options: tahoe, auto, 89b4fa, or hex)"
      echo "  • border_width:  $cur_width pt"
      echo "  • border_radius: $cur_radius pt (macOS Finder continuous squircle)"
      echo "  • padding:       $cur_padding pt (Content inset margin)"
      echo "  • engine:        $cur_engine (options: native, chrome)"
      echo "  • share_login:   $cur_share (sync SSO cookies between sgwebapp apps)"
      echo ""
      echo "Config file: $CONFIG_FILE"
      echo "Change settings with: sgwebapp config set <key> <value>"
      ;;
    set)
      if (( $# < 2 )); then
        log_error "Usage: sgwebapp config set <key> <value>"
        echo "Valid keys: border_color, border_width, border_radius, padding, engine, share_login, shared_cookie_domains"
        exit 1
      fi
      local k="$1" v="$2"
      case "$k" in
        border_color|border_width|border_radius|padding|engine|share_login|shared_cookie_domains) ;;
        *)
          log_error "Unknown config key: $k"
          echo "Valid keys: border_color, border_width, border_radius, padding, engine, share_login, shared_cookie_domains"
          exit 1
          ;;
      esac
      set_config_val "$k" "$v"
      log_success "Updated $k = $v in $CONFIG_FILE"
      ;;
    reset)
      cat > "$CONFIG_FILE" <<EOF
{
  "border_color": "tahoe",
  "border_width": 0.5,
  "border_radius": 26.0,
  "padding": 8.0,
  "engine": "native",
  "share_login": true
}
EOF
      log_success "Reset configuration to macOS Finder defaults (26pt radius, 0.5pt glass border, 8.0pt padding)."
      ;;
    *)
      log_error "Unknown config action: $action. Use 'sgwebapp config' or 'sgwebapp config set <key> <value>'."
      exit 1
      ;;
  esac
}

# Main routing
main() {
  local base_name
  base_name="$(basename "$0")"

  case "$base_name" in
    sgwebapp-install) cmd_install "$@"; return ;;
    sgwebapp-list) cmd_list "$@"; return ;;
    sgwebapp-launch) cmd_launch "$@"; return ;;
    sgwebapp-remove) cmd_remove "$@"; return ;;
  esac

  if (( $# == 0 )); then
    print_help
    exit 0
  fi

  local cmd="$1"
  shift

  case "$cmd" in
    install) cmd_install "$@" ;;
    list) cmd_list "$@" ;;
    launch) cmd_launch "$@" ;;
    remove) cmd_remove "$@" ;;
    config) cmd_config "$@" ;;
    border) cmd_border "$@" ;;
    import-cookies) cmd_import_cookies "$@" ;;
    cookies) cmd_cookies "$@" ;;
    version | -v | --version) echo "sgwebapp version $VERSION" ;;
    help | -h | --help) print_help ;;
    *)
      log_error "Unknown command: $cmd"
      print_help
      exit 1
      ;;
  esac
}

main "$@"
